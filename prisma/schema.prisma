// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostType {
  REQUEST
  PROMOTE
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  passwordHash    String
  name            String
  phone           String
  email           String
  privacyAgreedAt DateTime
  createdAt       DateTime @default(now())
  posts           Post[]
}

model Post {
  id        String   @id @default(cuid())
  type      PostType
  category  String
  title     String
  content   String
  budget    String?
  location  String?
  contact   String?
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  views     Int      @default(0)

  @@index([type, createdAt])
  @@index([category])
  @@index([location])
}

model Order {
  id         String       @id @default(cuid())
  orderDate  String
  clientName String       @default("")
  contact    String       @default("")
  product    String       @default("")
  quantity   Int          @default(1)
  unitPrice  Int          @default(0)
  amount     Int          @default(0)
  status     String       @default("보류")
  assignee   String       @default("")
  memo       String       @default("")
  detailText String       @default("")
  hasDetail  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  media      OrderMedia[]

  @@index([status, updatedAt])
  @@index([clientName])
}

model OrderMedia {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind         String
  fileName     String
  originalName String
  mimeType     String
  size         Int
  data         Bytes
  createdAt    DateTime @default(now())

  @@index([orderId, kind])
}

model Worker {
  id                String      @id @default(cuid())
  name              String
  hourlyWage        Int         @default(10320)
  holidayPayEnabled Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  wageMonths        WageMonth[]

  @@index([name])
}

model WageMonth {
  id                String   @id @default(cuid())
  workerId          String
  worker            Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  year              Int
  month             Int
  hourlyWage        Int
  holidayPayEnabled Boolean
  hoursByDate       Json
  memo              String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([workerId, year, month])
  @@index([year, month])
}

enum SaleMode {
  FIXED
  AUTO
  CONSULT
}

model ServiceCategory {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String           @default("")
  sortOrder   Int              @default(0)
  published   Boolean          @default(true)
  parentId    String?
  parent      ServiceCategory? @relation("CategoryTree", fields: [parentId], references: [id])
  children    ServiceCategory[] @relation("CategoryTree")
  products    ServiceProduct[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([published, sortOrder])
}

model ServiceProduct {
  id              String          @id @default(cuid())
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug            String
  name            String
  summary         String          @default("")
  description     String          @default("")
  thumbnailUrl    String          @default("")
  saleMode        SaleMode        @default(CONSULT)
  startingPrice   Int?
  durationLabel   String          @default("")
  scopeItems      Json            @default("[]")
  clientMaterials Json            @default("[]")
  revisionCount   String          @default("")
  processSteps    Json            @default("[]")
  faqItems        Json            @default("[]")
  estimateRule    Json            @default("{}")
  published       Boolean         @default(true)
  sortOrder       Int             @default(0)
  metaTitle       String          @default("")
  metaDescription String          @default("")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  inquiries       EstimateInquiry[]

  @@unique([categoryId, slug])
  @@index([published, sortOrder])
  @@index([saleMode])
}

model EstimateInquiry {
  id               String          @id @default(cuid())
  productId        String?
  product          ServiceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  companyName      String
  contactName      String
  phone            String
  email            String
  serviceName      String          @default("")
  budgetLabel      String          @default("")
  dueDate          String          @default("")
  message          String          @default("")
  privacyAgreedAt  DateTime
  estimateSnapshot Json            @default("{}")
  status           String          @default("신규")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([createdAt])
  @@index([status])
}
