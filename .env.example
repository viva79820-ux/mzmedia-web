# Neon Postgres connection string (Dashboard → Connection details → URI)
# Use the pooled connection for serverless/Vercel when available.
# Full checklist: docs/neon-vercel-setup.md
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# JWT signing secret for auth cookies (min 16 chars). Generate e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Bootstrap SUPER_ADMIN for MZ MEDIA OS (/os/login).
# If OS_ADMIN_* is omitted, ADMIN_PASSWORD is used once to seed username `admin`.
OS_ADMIN_USERNAME="admin"
OS_ADMIN_PASSWORD="change-me-os-admin-password"
# OS_ADMIN_EMAIL="owner@mzmedia.co.kr"

# Legacy shared admin password (optional after OS seed; still accepted by old mz_admin cookie APIs)
ADMIN_PASSWORD="change-me-admin-password"

# Google Drive. Share each customer folder with this service account.
# The private key keeps its line breaks as \n.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Optional Workspace user to impersonate when the service account has domain-wide delegation.
# Unread mail is sent from this @mzmedia.co.kr mailbox after 10 minutes. No separate mail product.
# GOOGLE_WORKSPACE_IMPERSONATE="owner@mzmedia.co.kr"
# CRON_SECRET="replace-with-a-long-random-string"
# OFFICE_ORIGIN="https://www.mzmedia.co.kr"

