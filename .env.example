# Neon Postgres connection string (Dashboard → Connection details → URI)
# Use the pooled connection for serverless/Vercel when available.
# Full checklist: docs/neon-vercel-setup.md
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# JWT signing secret for auth cookies (min 16 chars). Generate e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Bootstrap SUPER_ADMIN for MZ MEDIA OS (/os/login).
# If OS_ADMIN_* is omitted, ADMIN_PASSWORD is used once to seed username `admin`.
OS_ADMIN_USERNAME="admin"
OS_ADMIN_PASSWORD="change-me-os-admin-password"
# OS_ADMIN_EMAIL="owner@mzmedia.co.kr"

# Legacy shared admin password (optional after OS seed; still accepted by old mz_admin cookie APIs)
ADMIN_PASSWORD="change-me-admin-password"
